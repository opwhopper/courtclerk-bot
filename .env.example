DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_bot_application_client_id
GUILD_ID=your_test_guild_id

# Trello
TRELLO_KEY=your_trello_api_key
TRELLO_TOKEN=your_trello_token
TRELLO_BOARD_ID=your_trello_board_id
TRELLO_LIST_ID_DEFAULT=default_list_id_for_new_cards

# Role IDs (fill these with the actual role IDs from your server)
BOT_MANAGER_ID=permissions_role_id # RECOMMENDED: Bind this to a role specifically designed for permissions (e.g. "Courtroom Manager"); users/roles with administrator permissions bypass role restrictions.

ROLE_DOJ_ID=doj_role_id # For government attorneys (enables filing criminal cases, vacations)
ROLE_LAW_ENFORCEMENT_ID=law_enforcement_role_id 
ROLE_ATTORNEY_ID=attorney_role_id # Universal attorney role 

# Channels ([*] denotes optional; to remove simply leave blank)
JUDGE_REVIEW_CHANNEL_ID=channel_id_where_judges_review_appearances # [*] For appearances via /appear
LOG_CHANNEL_ID=channel_id_for_embed_logs # [*] For case submissions
TRANSCRIPT_ID=channel_id_for_transcripts # [*] For transcripts
WARRANTS_ID=channel_id_for_warrant_submissions # For warrant submissions via /warrant